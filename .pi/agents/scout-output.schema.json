{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Scout handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "task",
    "status",
    "summary",
    "facts",
    "recommendations",
    "unknowns",
    "handoff",
    "verification"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "task": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "partial",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F[1-9][0-9]*$"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "startLine",
                "endLine",
                "symbol"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "startLine": {
                  "type": "integer",
                  "minimum": 1
                },
                "endLine": {
                  "type": "integer",
                  "minimum": 1
                },
                "symbol": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                }
              }
            },
            "minItems": 1,
            "maxItems": 3
          }
        }
      },
      "minItems": 0,
      "maxItems": 12
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "reason",
          "files",
          "factIds"
        ],
        "properties": {
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "minItems": 1,
            "maxItems": 8
          },
          "factIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^F[1-9][0-9]*$"
            },
            "minItems": 1,
            "maxItems": 6
          }
        }
      },
      "minItems": 0,
      "maxItems": 8
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "impact",
          "nextStep"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "impact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "nextStep": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      },
      "minItems": 0,
      "maxItems": 6
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "firstFile",
        "steps",
        "doNotChange"
      ],
      "properties": {
        "firstFile": {
          "type": "string",
          "maxLength": 300
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "minItems": 0,
          "maxItems": 8
        },
        "doNotChange": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "minItems": 0,
          "maxItems": 8
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "filesRead",
        "filesNotRead",
        "commandsRun",
        "testsRun",
        "changesMade"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "const": "static-only"
        },
        "filesRead": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "minItems": 0,
          "maxItems": 40
        },
        "filesNotRead": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "minItems": 0,
          "maxItems": 20
        },
        "commandsRun": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 0
        },
        "testsRun": {
          "type": "boolean",
          "const": false
        },
        "changesMade": {
          "type": "boolean",
          "const": false
        }
      }
    }
  }
}
