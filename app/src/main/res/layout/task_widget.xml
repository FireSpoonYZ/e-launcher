<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/task_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/task_widget_back_two"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/task_widget_back"
        android:importantForAccessibility="no" />
    <ImageView
        android:id="@+id/task_widget_back_one"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="7dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/task_widget_back"
        android:importantForAccessibility="no" />
    <!-- Padding reserves the original 4dp per back card without scaling the foreground. -->
    <FrameLayout
        android:id="@+id/task_widget_front"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:id="@+id/task_widget_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingLeft="14dp"
            android:paddingTop="4dp"
            android:paddingRight="14dp"
            android:paddingBottom="10dp"
            android:elevation="1dp"
            android:outlineAmbientShadowColor="#365348"
            android:outlineSpotShadowColor="#365348"
            android:clipToOutline="true"
            android:background="@drawable/task_widget_background">
            <LinearLayout
                android:id="@+id/task_widget_heading"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/task_widget_brand_icon"
                    android:src="@drawable/task_widget_sparkles"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="8dp"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/task_widget_brand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/task_widget_name"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false" />
                <TextView
                    android:id="@+id/task_widget_status"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/task_widget_status"
                    android:textSize="10sp"
                    android:includeFontPadding="false" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no" />
                <ImageView
                    android:id="@+id/task_widget_folder"
                    android:src="@drawable/task_widget_folder"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="13dp"
                    android:focusable="true"
                    android:contentDescription="@string/task_widget_archived" />
                <TextView
                    android:id="@+id/task_widget_position"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:includeFontPadding="false" />
                <LinearLayout
                    android:id="@+id/task_widget_switch"
                    android:visibility="gone"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:orientation="vertical">
                    <ImageView
                        android:id="@+id/task_widget_previous"
                        android:layout_width="48dp"
                        android:layout_height="24dp"
                        android:paddingLeft="16dp"
                        android:paddingTop="6dp"
                        android:paddingRight="16dp"
                        android:paddingBottom="2dp"
                        android:focusable="true"
                        android:contentDescription="@string/task_widget_previous" />
                    <ImageView
                        android:id="@+id/task_widget_next"
                        android:layout_width="48dp"
                        android:layout_height="24dp"
                        android:paddingLeft="16dp"
                        android:paddingTop="2dp"
                        android:paddingRight="16dp"
                        android:paddingBottom="6dp"
                        android:focusable="true"
                        android:contentDescription="@string/task_widget_next" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/task_widget_body"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:focusable="true">
                <TextView
                    android:id="@+id/task_widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end" />
                <TextView
                    android:id="@+id/task_widget_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:textSize="12sp"
                    android:includeFontPadding="false" />
                <ImageView
                    android:id="@+id/task_widget_steps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitStart" />
            </LinearLayout>
            <ImageView
                android:id="@+id/task_widget_empty_icon"
                android:src="@drawable/task_widget_sparkles"
                android:layout_width="56dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_gravity="center_horizontal"
                android:scaleType="center"
                android:importantForAccessibility="no" />
            <LinearLayout
                android:id="@+id/task_widget_actions"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="7dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/task_widget_archive"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/task_widget_archive"
                    android:text="@string/task_widget_archive"
                    android:textSize="15sp"
                    android:includeFontPadding="false"
                    android:focusable="true" />
                <TextView
                    android:id="@+id/task_widget_chat"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:background="@drawable/task_widget_chat"
                    android:text="@string/task_widget_chat"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:includeFontPadding="false"
                    android:focusable="true" />
            </LinearLayout>
            <TextView
                android:id="@+id/task_widget_start"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="32dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:gravity="center"
                android:background="@drawable/task_widget_start"
                android:text="@string/task_widget_start"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:includeFontPadding="false"
                android:focusable="true" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
