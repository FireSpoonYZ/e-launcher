<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/task_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/task_widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/task_widget_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="@string/task_widget_name"
            android:textColor="#142D34"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
        <Button
            android:id="@+id/task_widget_previous"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:background="?android:attr/selectableItemBackground"
            android:text="‹"
            android:textSize="24sp"
            android:textColor="#19695D"
            android:contentDescription="@string/task_widget_previous" />
        <Button
            android:id="@+id/task_widget_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:background="?android:attr/selectableItemBackground"
            android:text="›"
            android:textSize="24sp"
            android:textColor="#19695D"
            android:contentDescription="@string/task_widget_next" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/task_widget_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:contentDescription="@string/task_widget_open_detail">
        <TextView
            android:id="@+id/task_widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/task_widget_empty"
            android:textColor="#19695D"
            android:textSize="12sp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/task_widget_step"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/task_widget_detail_hint"
            android:textColor="#142D34"
            android:textSize="12sp"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/task_widget_result"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:textColor="#435B61"
            android:textSize="12sp"
            android:includeFontPadding="false"
            android:maxLines="3"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/task_widget_updated"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/task_widget_snapshot_hint"
            android:textColor="#435B61"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/task_widget_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingEnd="0dp"
            android:textColor="#435B61"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/task_widget_new_chat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:text="@string/task_widget_new_chat"
            android:textColor="#19695D"
            android:textSize="14sp"
            android:maxLines="1" />
        <Button
            android:id="@+id/task_widget_voice"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:text="@string/task_widget_voice"
            android:textColor="#19695D"
            android:textSize="14sp"
            android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
