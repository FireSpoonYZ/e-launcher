{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Native capability manifest",
  "type": "object",
  "required": ["manifestVersion", "id", "version", "kind", "displayName", "hostApi", "durableApi", "components", "platforms", "configSchema"],
  "properties": {
    "manifestVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "kind": { "const": "plugin" },
    "displayName": { "type": "string", "minLength": 1 },
    "hostApi": { "type": "string", "minLength": 1 },
    "durableApi": { "type": "string", "minLength": 1 },
    "components": {
      "type": "object",
      "properties": {
        "host": { "$ref": "#/definitions/component" },
        "center": { "$ref": "#/definitions/component" }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "platforms": { "type": "array", "items": { "enum": ["windows", "linux", "android"] }, "minItems": 1, "uniqueItems": true },
    "configSchema": { "type": "string", "minLength": 1 },
    "uiSchema": { "type": "string", "minLength": 1 },
    "stateVersion": { "type": "integer", "minimum": 1 },
    "skills": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "actions": { "type": "array", "items": { "$ref": "#/definitions/action" } },
    "contributions": { "type": "array", "items": { "enum": ["tools", "context", "background", "actions"] }, "uniqueItems": true }
  },
  "definitions": {
    "action": {
      "type": "object",
      "required": ["id", "title", "inputSchema"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "inputSchema": { "type": ["object", "boolean"] },
        "outputSchema": { "type": ["object", "boolean"] }
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": ["entry"],
      "properties": { "entry": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
