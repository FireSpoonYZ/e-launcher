{
  "manifestVersion": 1,
  "id": "e-launcher.todo",
  "version": "1.0.0",
  "kind": "plugin",
  "displayName": "Todo",
  "hostApi": "^1.0.0",
  "durableApi": "1.4.0",
  "components": {
    "host": {
      "entry": "entry.js"
    }
  },
  "platforms": ["windows", "linux", "android"],
  "configSchema": "config.schema.json",
  "stateVersion": 1,
  "contributions": ["tools", "context", "actions"],
  "actions": [
    {
      "id": "todoStatus",
      "title": "Todo status",
      "inputSchema": {
        "type": "object",
        "properties": {
          "scopeId": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  ]
}
