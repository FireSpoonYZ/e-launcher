{
  "manifestVersion": 1,
  "id": "e-launcher.ask-user-question",
  "version": "1.0.0",
  "kind": "plugin",
  "displayName": "Ask User Question",
  "hostApi": "^1.0.0",
  "durableApi": "1.4.0",
  "components": {
    "host": {
      "entry": "entry.js"
    }
  },
  "platforms": ["windows", "linux", "android"],
  "configSchema": "config.schema.json",
  "stateVersion": 1,
  "contributions": ["tools", "actions"],
  "actions": [
    {
      "id": "answerQuestionnaire",
      "title": "Answer questionnaire",
      "inputSchema": {
        "type": "object",
        "properties": {
          "conversationId": { "type": "integer", "minimum": 1 },
          "requestId": { "type": "string", "minLength": 1, "maxLength": 64 },
          "cancelled": { "type": "boolean" },
          "answers": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "properties": {
                "questionIndex": { "type": "integer", "minimum": 0, "maximum": 3 },
                "selectedOptions": {
                  "type": "array",
                  "maxItems": 4,
                  "items": { "type": "integer", "minimum": 0, "maximum": 3 }
                },
                "customText": { "type": "string", "maxLength": 2000 },
                "notes": { "type": "string", "maxLength": 2000 }
              },
              "required": ["questionIndex"],
              "additionalProperties": false
            }
          },
          "globalNote": { "type": "string", "maxLength": 2000 }
        },
        "required": ["conversationId", "requestId", "cancelled", "answers"],
        "additionalProperties": false
      }
    }
  ]
}
