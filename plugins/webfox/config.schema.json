    "timeoutMs": {
      "type": "integer",
      "title": "请求超时（毫秒）",
      "description": "普通 search/contents/answer 请求的整体截止时间，包含凭据解析与重试。",
      "minimum": 1000,
      "maximum": 600000
    },
    "researchTimeoutMs": {
      "type": "integer",
      "title": "调研超时（毫秒）",
      "description": "research 工具的整体截止时间，前台等待，超时返回错误。",
      "minimum": 1000,
      "maximum": 3600000
    },
    "retries": {
      "type": "integer",
      "title": "重试次数",
      "description": "瞬态失败的重试次数（默认不重试）。",
      "minimum": 0,
      "maximum": 5
    },
    "concurrency": {
      "type": "integer",
      "title": "并发输入数",
      "description": "一次调用中多个 query/URL 的并发数。",
      "minimum": 1,
      "maximum": 16
    }
  },
