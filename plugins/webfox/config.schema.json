    "credentials": {
      "type": "object",
      "title": "凭据引用",
      "description": "只保存凭据库引用，不保存密钥明文。Brave 的搜索与问答是两套密钥；Cloudflare 需要 API token 与 Account ID 两项。",
      "properties": {
        "braveSearch": {
          "type": "string",
          "format": "credential-ref",
          "minLength": 1,
          "title": "Brave 搜索密钥",
          "description": "对应 BRAVE_SEARCH_API_KEY。"
        },
        "braveAnswers": {
          "type": "string",
          "format": "credential-ref",
          "minLength": 1,
          "title": "Brave 问答密钥",
          "description": "对应 BRAVE_ANSWERS_API_KEY（answer/research）。"
        },
        "cloudflareToken": {
          "type": "string",
          "format": "credential-ref",
          "minLength": 1,
          "title": "Cloudflare API Token",
          "description": "对应 CLOUDFLARE_API_TOKEN。"
        },
        "cloudflareAccountId": {
          "type": "string",
          "format": "credential-ref",
          "minLength": 1,
          "title": "Cloudflare Account ID",
          "description": "对应 CLOUDFLARE_ACCOUNT_ID。"
        },
        "exa": {
          "type": "string",
          "format": "credential-ref",
