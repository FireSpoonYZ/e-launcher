{
  "productName": "e-助手",
  "version": "1.0.0",
  "identifier": "com.example.launcherprobe",
  "build": {
    "frontendDist": "../build/web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "e-助手",
        "url": "index.html",
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src ipc: https://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'",
      "capabilities": ["main"],
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["../../app/src/main/res/drawable-nodpi/ic_launcher_artwork.png"]
  }
}
